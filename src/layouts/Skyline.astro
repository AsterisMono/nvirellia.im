---
import "../styles/global.css";
import { nav } from "../data/porch";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "noa · nvirellia.im",
  description = "i'm noa. full-spectrum infrastructure person who thinks systems should be warm environments for people, not cold monuments to engineering.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="banner" role="img" aria-label="Skyline, a rescued layout by sadgrl.online"></header>
    <nav aria-label="Skyline">
      <ul class="nav">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                {...("external" in item && item.external ? { rel: "noreferrer" } : {})}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex">
      <slot />
    </div>
    <footer>
      <p>
        This layout was lovingly re-crafted by <a href="https://sadgrl.online">sadgrl.online</a>
        from the <a href="https://www.createblog.com/website-templates/36491-skyline/">Skyline</a>
        layout on CreateBlog.
        <a href="https://codepen.io/sadness97/pen/jOaqGdZ">Skyline [R]</a>.
      </p>
      <p>
        noa · <a href="https://github.com/AsterisMono">AsterisMono</a>
      </p>
    </footer>
  </body>
</html>
