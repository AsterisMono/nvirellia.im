---
import Skyline from "../layouts/Skyline.astro";
import LinkList from "../components/LinkList.astro";
import RichText from "../components/RichText.astro";
import {
  aboutCraft,
  aboutLead,
  elsewhereLinks,
  epigraph,
  epigraphClose,
  featuredLinks,
  garden,
  hero,
  highlights,
  notes,
  sections,
  stuffIDo,
  works,
} from "../data/porch";

const featured = works.filter((work) => work.group === "featured");
const other = works.filter((work) => work.group === "other");
---

<Skyline>
  <aside
    class="mt-[30px] w-[250px] shrink-0 text-sidebar max-[900px]:mx-5 max-[900px]:flex max-[900px]:w-[calc(100%-2.5rem)] max-[900px]:gap-2.5 max-[640px]:flex-col"
  >
    <section class="mb-2.5 min-w-0 max-[900px]:mb-0 max-[900px]:flex-1" aria-label="Welcome">
      <h2 class="subtitle">Welcome</h2>
      <p>
        {epigraph[0]}<br />
        {epigraph[1]}
      </p>
      <p>{epigraphClose}</p>
    </section>
    <LinkList id="herbarium" title="Sections" items={sections.map((section) => ({ label: section.name, href: section.href }))} />
    <LinkList
      title="Notes"
      items={[
        ...notes.map((note) => ({ label: note.title, href: note.href })),
        { label: "herbarium.requiem.garden", href: `${garden}/` },
      ]}
    />
  </aside>

  <main class="mx-5 min-w-0 flex-1 max-[900px]:w-[calc(100%-2.5rem)] max-[900px]:flex-none">
    <article id="home" class="mb-[15px] border border-line-strong bg-article p-2.5 text-body" lang="en">
      <h2 class="subtitle">noa</h2>
      <p><em>{hero.kicker}</em></p>
      {hero.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <blockquote class="mx-[5px] my-3 border-l-2 border-line-strong pl-3 text-sidebar">
        <p>
          {epigraph[0]}<br />
          {epigraph[1]}
        </p>
        <p>
          {epigraphClose}
          <a href={`${garden}/`}>herbarium</a>
        </p>
      </blockquote>
    </article>

    <article id="about" class="mb-[15px] border border-line-strong bg-article p-2.5 text-body" lang="en">
      <h2 class="subtitle">about</h2>
      {aboutLead.map((paragraph) => <p>{paragraph}</p>)}

      <h3 class="mt-3 mb-1 px-[5px] font-bold tracking-wide text-heading">Pronouns</h3>
      <p>she/they 🏳️‍⚧️.</p>
      <p>Still believes magic might arrive one day and turn her into a cute girl, then looks back and finds the age for HRT has already passed.</p>
      <p>
        <del>So, <em>for now</em>, a straight(?) guy who is a friend to trans people.</del>
        <em>Take her hand, and set her free. — 2025.06.01</em>
      </p>

      <h3 class="mt-3 mb-1 px-[5px] font-bold tracking-wide text-heading">what i can do</h3>
      {aboutCraft.map((parts) => (
        <p>
          <RichText parts={parts} />
        </p>
      ))}
      <p class="px-[5px] font-bold">Highlights:</p>
      <ul class="links">
        {highlights.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>

      <h3 class="mt-3 mb-1 px-[5px] font-bold tracking-wide text-heading" lang="en">stuff i do</h3>
      <ul class="mx-[5px] list-disc pl-4" lang="en">
        {stuffIDo.map((parts) => (
          <li>
            <RichText parts={parts} />
          </li>
        ))}
      </ul>

      <h3 class="mt-3 mb-1 px-[5px] font-bold tracking-wide text-heading">virtual presence and friends</h3>
      <p>
        Lives in Requiem Garden with <a href={`${garden}/lyra-and-noa`}>Lyra</a>.
      </p>
      <p>
        Started a virtual software consultancy, <a href="https://github.com/UnnecessarilyComplicated">Unnecessarily Complicated</a>. So far it has neither clients nor code.
      </p>
      <p>
        Would like to make friends. A <a href="https://t.me/noa_virellia">message</a>,
        an <a href="mailto:noa@requiem.garden">email</a>,
        or a comment is welcome.
      </p>
    </article>

    <article id="works" class="mb-[15px] border border-line-strong bg-article p-2.5 text-body" lang="en">
      <h2 class="subtitle">works</h2>
      <h3 class="mt-1 mb-2 px-[5px] font-bold tracking-wide text-heading">featured stuff i made</h3>
      <ul class="m-0 grid list-none gap-2.5 p-0">
        {featured.map((work) => (
          <li>
            <a class="work-name" href={work.href}>{work.name}</a>
            <p class="mx-[5px]">
              <RichText parts={work.blurb} />
            </p>
          </li>
        ))}
      </ul>
      <h3 class="mt-3 mb-2 px-[5px] font-bold tracking-wide text-heading">other works</h3>
      <ul class="m-0 grid list-none gap-2.5 p-0">
        {other.map((work) => (
          <li>
            <a class="work-name" href={work.href}>{work.name}</a>
            <p class="mx-[5px]">
              <RichText parts={work.blurb} />
              {work.warning ? <em> content warning.</em> : null}
            </p>
          </li>
        ))}
      </ul>
    </article>
  </main>

  <aside
    id="elsewhere"
    class="mt-[30px] w-[250px] shrink-0 text-sidebar max-[900px]:mx-5 max-[900px]:flex max-[900px]:w-[calc(100%-2.5rem)] max-[900px]:gap-2.5 max-[640px]:flex-col"
  >
    <section class="mb-2.5 min-w-0 max-[900px]:mb-0 max-[900px]:flex-1" lang="en">
      <h2 class="subtitle">Elsewhere</h2>
      <p>blog / kb: herbarium.requiem.garden</p>
      <p>telegram: @noa_virellia</p>
      <p>mail: noa@requiem.garden</p>
      <p>dn42: AS4242420833</p>
    </section>
    <LinkList title="Links" items={elsewhereLinks} />
    <LinkList title="Featured" items={featuredLinks} />
  </aside>
</Skyline>
