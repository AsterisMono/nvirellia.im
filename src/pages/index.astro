---
import Skyline from "../layouts/Skyline.astro";
import LinkList from "../components/LinkList.astro";
import RichText from "../components/RichText.astro";
import {
  aboutCraft,
  aboutLead,
  elsewhereLinks,
  epigraph,
  featuredLinks,
  garden,
  hero,
  highlights,
  notes,
  sections,
  stuffIDo,
  works,
} from "../data/porch";

const featured = works.filter((work) => work.group === "featured");
const other = works.filter((work) => work.group === "other");
---

<Skyline>
  <aside
    class="mt-[30px] w-[250px] shrink-0 text-sidebar max-[800px]:mx-5 max-[800px]:flex max-[800px]:w-[calc(100%-2.5rem)] max-[800px]:gap-2.5 max-[640px]:flex-col"
  >
    <section class="mb-2.5 min-w-0 max-[800px]:mb-0 max-[800px]:flex-1" aria-label="Welcome">
      <h2 class="subtitle">Welcome</h2>
      <p lang="zh-CN">
        {epigraph[0]}<br />
        {epigraph[1]}
      </p>
      <p lang="zh-CN">尽情闪耀</p>
    </section>
    <LinkList id="herbarium" title="Sections" items={sections.map((section) => ({ label: section.name, href: section.href }))} />
    <LinkList
      title="Notes"
      items={[
        ...notes.map((note) => ({ label: note.title, href: note.href })),
        { label: "herbarium.requiem.garden", href: `${garden}/` },
      ]}
    />
  </aside>

  <main class="mx-5 min-w-0 flex-1 max-[800px]:w-full max-[800px]:flex-none">
    <article id="home" class="mb-[15px] border border-line-strong bg-article p-2.5 text-body" lang="en">
      <h2 class="subtitle">noa</h2>
      <p><em>{hero.kicker}</em></p>
      {hero.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <blockquote class="mx-[5px] my-3 border-l-2 border-line-strong pl-3 text-sidebar" lang="zh-CN">
        <p>
          {epigraph[0]}<br />
          {epigraph[1]}
        </p>
        <p>
          尽情闪耀
          <a href={`${garden}/`}>herbarium</a>
        </p>
      </blockquote>
    </article>

    <article id="about" class="mb-[15px] border border-line-strong bg-article p-2.5 text-body">
      <h2 class="subtitle">about</h2>
      {aboutLead.map((paragraph) => <p>{paragraph}</p>)}

      <h3 class="mt-3 mb-1 px-[5px] font-bold tracking-wide text-heading">Pronouns</h3>
      <p>she/they 🏳️‍⚧️。</p>
      <p>依然相信某天会有魔法降临把自己变成可爱的女孩子，可转头一看已经过了 HRT 的年纪。</p>
      <p>
        <del>所以<em>目前</em>是友跨直（?）男。</del>
        <em>Take her hand, and set her free. —— 2025.06.01</em>
      </p>

      <h3 class="mt-3 mb-1 px-[5px] font-bold tracking-wide text-heading">我会做什么</h3>
      {aboutCraft.map((parts) => (
        <p>
          <RichText parts={parts} />
        </p>
      ))}
      <p class="px-[5px] font-bold">Highlights:</p>
      <ul class="links">
        {highlights.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>

      <h3 class="mt-3 mb-1 px-[5px] font-bold tracking-wide text-heading" lang="en">stuff i do</h3>
      <ul class="mx-[5px] list-disc pl-4" lang="en">
        {stuffIDo.map((parts) => (
          <li>
            <RichText parts={parts} />
          </li>
        ))}
      </ul>

      <h3 class="mt-3 mb-1 px-[5px] font-bold tracking-wide text-heading">虚拟存在与朋友们</h3>
      <p>
        和 <a href={`${garden}/lyra-and-noa`}>Lyra</a> 老师一起生活在 Requiem Garden。
      </p>
      <p>
        成立了一家虚拟软件咨询公司：<a href="https://github.com/UnnecessarilyComplicated">Unnecessarily Complicated</a>，不过目前既没有业务，也没有代码。
      </p>
      <p>
        希望交朋友！欢迎
        <a href="https://t.me/noa_virellia">私信</a>
        /
        <a href="mailto:noa@requiem.garden">邮件</a>
        / 评论联系我🙇
      </p>
    </article>

    <article id="works" class="mb-[15px] border border-line-strong bg-article p-2.5 text-body" lang="en">
      <h2 class="subtitle">works</h2>
      <h3 class="mt-1 mb-2 px-[5px] font-bold tracking-wide text-heading">featured stuff i made</h3>
      <ul class="m-0 grid list-none gap-2.5 p-0">
        {featured.map((work) => (
          <li>
            <a class="work-name" href={work.href}>{work.name}</a>
            <p class="mx-[5px]">
              <RichText parts={work.blurb} />
            </p>
          </li>
        ))}
      </ul>
      <h3 class="mt-3 mb-2 px-[5px] font-bold tracking-wide text-heading">other works</h3>
      <ul class="m-0 grid list-none gap-2.5 p-0">
        {other.map((work) => (
          <li>
            <a class="work-name" href={work.href}>{work.name}</a>
            <p class="mx-[5px]">
              <RichText parts={work.blurb} />
              {work.warning ? <em> content warning.</em> : null}
            </p>
          </li>
        ))}
      </ul>
    </article>
  </main>

  <aside
    id="elsewhere"
    class="mt-[30px] w-[250px] shrink-0 text-sidebar max-[800px]:mx-5 max-[800px]:flex max-[800px]:w-[calc(100%-2.5rem)] max-[800px]:gap-2.5 max-[640px]:flex-col"
  >
    <section class="mb-2.5 min-w-0 max-[800px]:mb-0 max-[800px]:flex-1" lang="en">
      <h2 class="subtitle">Elsewhere</h2>
      <p>blog / kb: herbarium.requiem.garden</p>
      <p>telegram: @noa_virellia</p>
      <p>mail: noa@requiem.garden</p>
      <p>dn42: AS4242420833</p>
    </section>
    <LinkList title="Links" items={elsewhereLinks} />
    <LinkList title="Featured" items={featuredLinks} />
  </aside>
</Skyline>
