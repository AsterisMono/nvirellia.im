---
import {
  epigraph,
  epigraphClose,
  garden,
  notes,
  sections,
} from "../data/porch";

const telegram = "https://t.me/noa_virellia";
const github = "https://github.com/AsterisMono";
const mail = "mailto:noa@requiem.garden";
const talks = "https://www.youtube.com/watch?v=WLRRJjACyBs";

const featured = [
  {
    name: "flake",
    href: "https://github.com/AsterisMono/flake",
    line: "my NixOS config",
  },
  {
    name: "mimosa",
    href: "https://github.com/AsterisMono/mimosa",
    line: "Talos Linux and Terraform",
  },
  {
    name: "aster",
    href: "https://github.com/AsterisMono/aster",
    line: "chromium with vertical tabs",
  },
  {
    name: "reverie",
    href: "https://github.com/AsterisMono/reverie",
    line: "a quiet workstation",
  },
];

const also = [
  {
    name: "sidebery-chromium",
    href: "https://github.com/AsterisMono/Sidebery",
  },
  {
    name: "astro-llm-translator",
    href: "https://github.com/AsterisMono/astro-llm-translator",
  },
  {
    name: "rimlight-protocol",
    href: "https://github.com/AsterisMono/solana-workspace/tree/main/rimlight_protocol",
    note: "content warning",
  },
];

const blooms = notes.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>noa · nvirellia.im</title>
    <meta
      name="description"
      content="i'm noa. this porch is a thin door to the garden."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/xanga.css" />
  </head>
  <body>
    <div class="container">
      <div class="header">
        <div class="header-left">
          <a href="#home">noa</a>: <a href="#home">home</a> - <a href="#about">about</a> - <a href="#works">works</a> - <a href="#herbarium">herbarium</a> - <a href="#elsewhere">elsewhere</a> - <a href={`${garden}/`}>weblog</a>
        </div>
        <div class="header-right">
          <a href={github}>github</a> - <a href={telegram}>telegram</a> - <a href={mail}>mail</a>
        </div>
      </div>
      <div class="flex">
        <div class="left">
          <div class="box" id="about">
            <div class="boxwrap">
              <div class="subtitle"><strong>noa</strong></div>
              she/they<br /><br />
              full-spectrum infrastructure person who thinks systems should be warm environments for people, not cold monuments to engineering.<br /><br />
              immutable os. servers named after plants.<br />
              <a href={talks}>nix meetup talks</a><br />
              tending flowers in the wires.
            </div>
          </div>
          <div class="box" id="works">
            <div class="boxwrap">
              <div class="subtitle">Works</div>
              {
                featured.map((work) => (
                  <>
                    <a href={work.href}>{work.name}</a> — {work.line}
                    <br />
                  </>
                ))
              }
              <br />
              <div class="subtitle">also</div>
              {
                also.map((work) => (
                  <>
                    <a href={work.href}>{work.name}</a>
                    {work.note ? ` (${work.note})` : null}
                    <br />
                  </>
                ))
              }
            </div>
          </div>
          <div class="box" id="herbarium">
            <div class="boxwrap">
              <div class="subtitle">Herbarium</div>
              {
                sections.map((section) => (
                  <>
                    <a href={section.href}>{section.name}</a>
                    <br />
                  </>
                ))
              }
              <a class="blogring" href={blooms[0].href}>{blooms[0].title}</a>
              <div class="blogringLinks">
                <a href={blooms[1].href}>{blooms[1].title}</a> - <a href={blooms[2].href}>{blooms[2].title}</a>
              </div>
            </div>
          </div>
          <div class="box" id="elsewhere">
            <div class="boxwrap">
              <div class="subtitle">Elsewhere</div>
              <a href={`${garden}/`}>herbarium.requiem.garden</a><br />
              <a href={telegram}>telegram @noa_virellia</a><br />
              <a href={github}>GitHub AsterisMono</a><br />
              <a href={mail}>noa@requiem.garden</a><br />
              dn42 AS4242420833
            </div>
          </div>
        </div>
        <div class="right">
          <div class="post" id="home">
            <div class="title">welcome</div>
            <div class="entry">
              <p>i'm noa. i want the systems around people to stay warm.</p>
              <p>this porch is a thin door. the notes live in the garden, not here.</p>
              <p>
                {epigraph[0]}<br />
                {epigraph[1]}
              </p>
              <p>
                {epigraphClose}<br />
                <a href={`${garden}/`}>herbarium.requiem.garden</a>
              </p>
            </div>
            <div class="postFooter">
              <a href={`${garden}/`}>herbarium.requiem.garden</a>
            </div>
          </div>
        </div>
      </div>
      <div class="footer">
        This  layout was lovingly re-crafted by <a href="https://sadgrl.online/">sadgrl.online</a>
      </div>
    </div>
  </body>
</html>
