---
interface Item {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  items: Item[];
  id?: string;
}

const { title, items, id } = Astro.props;
---

<section id={id}>
  <h2 class="subtitle">{title}</h2>
  <ul class="links">
    {
      items.map((item) => (
        <li>
          {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
        </li>
      ))
    }
  </ul>
</section>
